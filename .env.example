# Copy to .env and adjust before `docker compose up`
#   cp .env.example .env

# Match host user so files under ./data stay owned correctly
HERMES_UID=1000
HERMES_GID=1000

# Container timezone
TZ=Asia/Taipei

# Published ports
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119

# Dashboard (required when binding non-loopback; official image defaults to 0.0.0.0)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
# Optional: stable session secret across restarts (openssl rand -hex 32)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Resource limits (GUI + browser needs more RAM)
HERMES_MEMORY_LIMIT=8G
HERMES_CPU_LIMIT=4.0

# Linux desktop GUI (XFCE + TigerVNC + noVNC)
# VNC password is only written on first boot if data/.vnc/passwd does not exist.
VNC_PASSWORD=change-me
VNC_DISPLAY=:1
VNC_PORT=5901
VNC_GEOMETRY=1920x1080
HERMES_VNC_PORT=5901
HERMES_NOVNC_WS_PORT=6080
HERMES_NOVNC_HTTP_PORT=6081
