# cp .env.example .env

# =============================================================================
# 映像建置（docker compose build）
# =============================================================================
HERMES_IMAGE_NAME=hermes-agent-ubuntu-gui
HERMES_IMAGE_TAG=local
UBUNTU_VERSION=24.04
HERMES_BRANCH=main
# HERMES_COMMIT=abc123   # 可選：釘選特定 commit
HERMES_SKIP_BROWSER=0    # 1=略過 Playwright/Chromium（省空間與建置時間）

# VNC 密碼（建置時寫入映像；生產環境請改用強密碼並重建映像）
VNC_PASSWORD=hermes

# =============================================================================
# 執行時
# =============================================================================
HERMES_DATA_DIR=./data
HERMES_CONTAINER_NAME=hermes
HERMES_UID=1000
HERMES_GID=1000
HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0

# GUI
HERMES_GUI_ENABLED=1
VNC_RESOLUTION=1920x1080
HERMES_VNC_BIND=127.0.0.1
HERMES_VNC_PORT=5901
HERMES_NOVNC_BIND=127.0.0.1
HERMES_NOVNC_PORT=6080

# Hermes 服務埠
HERMES_GATEWAY_BIND=127.0.0.1
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD=1

# 以 root 執行 Hermes（權限等同 root，可避免 volume 權限問題；安全性較低）
# HERMES_RUN_AS_ROOT=1

# 若需掛載 Docker socket 讓 Hermes 操作主機 Docker（高風險）：
# 取消 docker-compose.yml 內 volumes / privileged 註解

# =============================================================================
# 本機 Ollama（容器內 Hermes 連線）
# =============================================================================
# 方式 A：Ollama 跑在宿主機（最常見）
#   宿主機：ollama serve && ollama pull llama3.2
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_CONTEXT_LENGTH=65536

# 方式 B：Ollama 跑在 Compose（docker compose --profile ollama up -d）
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=llama3.2

# OLLAMA_AUTO_CONFIG=1   # 1=啟動時自動寫入 ./data/config.yaml（預設）

# =============================================================================
# SearXNG 搜尋（docker compose --profile searxng up -d）
# =============================================================================
# SEARXNG_URL=http://searxng:8080
# SEARXNG_AUTO_CONFIG=1
# OPENROUTER_API_KEY=
# TELEGRAM_BOT_TOKEN=
