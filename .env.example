# Copy to .env and adjust before `docker compose up`
#   cp .env.example .env

# Match host user so files under ./data stay owned correctly
HERMES_UID=1000
HERMES_GID=1000

# Container timezone
TZ=Asia/Taipei

# Published ports
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119

# SearXNG web-search backend (published on 127.0.0.1 only)
HERMES_SEARXNG_PORT=18080
# SearXNG will not start without a secret. Generate one: openssl rand -hex 32
SEARXNG_SECRET=change-me

# Vision model for images and computer_use screenshots. Any OpenAI-compatible
# endpoint; leave empty to let Hermes pick a provider automatically.
# Requires the ${AUXILIARY_VISION_*} block in data/config.yaml — see README.
#
#   Ollama on this host (reachable via host.docker.internal):
#     AUXILIARY_VISION_BASE_URL=http://host.docker.internal:11434/v1
#     AUXILIARY_VISION_MODEL=qwen3.5:9b
#     AUXILIARY_VISION_API_KEY=ollama
#     AUXILIARY_VISION_REASONING_EFFORT=none   # thinking models emit empty content otherwise
#
#   OpenRouter:
#     AUXILIARY_VISION_BASE_URL=https://openrouter.ai/api/v1
#     AUXILIARY_VISION_MODEL=google/gemini-3.6-flash
#     AUXILIARY_VISION_API_KEY=sk-or-...
#     AUXILIARY_VISION_REASONING_EFFORT=
AUXILIARY_VISION_BASE_URL=
AUXILIARY_VISION_MODEL=
AUXILIARY_VISION_API_KEY=
AUXILIARY_VISION_REASONING_EFFORT=

# Dashboard (required when binding non-loopback; official image defaults to 0.0.0.0)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
# Optional: stable session secret across restarts (openssl rand -hex 32)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Resource limits (GUI + browser needs more RAM)
HERMES_MEMORY_LIMIT=8G
HERMES_CPU_LIMIT=4.0

# Linux desktop GUI (XFCE + TigerVNC + noVNC)
# VNC password is only written on first boot if data/.vnc/passwd does not exist.
# Note: the VNC protocol truncates passwords to 8 characters.
VNC_PASSWORD=change-me
# Host interface for the VNC / noVNC ports. Keep loopback unless you trust the network.
HERMES_GUI_BIND_ADDRESS=127.0.0.1
VNC_DISPLAY=:1
VNC_PORT=5901
# Keep the longest edge <= 1456. Hermes downscales bigger screenshots before the
# vision model sees them and asks it to scale coordinates back up, which is a
# reliable source of mis-aimed clicks. At or below 1456 the screenshot, the
# screen, and xdotool all share one coordinate space.
VNC_GEOMETRY=1440x900
HERMES_VNC_PORT=5901
# Single port serves both the noVNC page and its WebSocket
HERMES_NOVNC_PORT=6080
