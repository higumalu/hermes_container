#!/command/with-contenv bash
set -euo pipefail

HERMES_HOME="${HERMES_HOME:-/opt/data}"
export HOME="${HERMES_HOME}"
VNC_DISPLAY="${VNC_DISPLAY:-:1}"
VNC_PORT="${VNC_PORT:-5901}"
VNC_GEOMETRY="${VNC_GEOMETRY:-1920x1080}"
NOVNC_WS_PORT="${NOVNC_WS_PORT:-6080}"
XSTARTUP="${HERMES_HOME}/.vnc/xstartup"

WS_PID=""

as_hermes() {
  if [ "$(id -un)" = "hermes" ]; then
    "$@"
  else
    s6-setuidgid hermes "$@"
  fi
}

cleanup() {
  [ -n "${WS_PID}" ] && kill "${WS_PID}" 2>/dev/null || true
  as_hermes vncserver -kill "${VNC_DISPLAY}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

as_hermes vncserver -kill "${VNC_DISPLAY}" 2>/dev/null || true

as_hermes vncserver "${VNC_DISPLAY}" \
  -geometry "${VNC_GEOMETRY}" -depth 24 \
  -rfbport "${VNC_PORT}" -localhost no \
  -xstartup "${XSTARTUP}" -fg &

VNC_PID=$!

for _ in $(seq 1 60); do
  if nc -z 127.0.0.1 "${VNC_PORT}" 2>/dev/null; then
    break
  fi
  sleep 0.5
done

# --web serves the noVNC HTML from the same port as the WebSocket, so
# vnc_lite.html defaults its host/port to the page's own and needs no query
# string. Saves a published port and a second network-facing process.
# Runs as hermes: the port is above 1024, so nothing here needs root.
as_hermes websockify --web /usr/share/novnc "0.0.0.0:${NOVNC_WS_PORT}" "127.0.0.1:${VNC_PORT}" &
WS_PID=$!

# Exit as soon as either process dies so s6 restarts the whole stack. Waiting on
# vncserver alone left a dead websockify unnoticed: the desktop looked healthy
# but nothing could connect to it.
wait -n "${VNC_PID}" "${WS_PID}"
